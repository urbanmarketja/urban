PORT=4000
FRONTEND_ORIGIN=http://localhost:4200

# MySQL connection details. Leave blank / false to keep using the in-memory mock data.
DB_HOST=your-aiven-host
DB_PORT=3306
DB_NAME=your-aiven-database
DB_USER=your-aiven-user
DB_PASSWORD=your-aiven-password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=
DB_SSL_CA=


# Set to true only after MySQL is configured and mysql2 is installed.
USE_DATABASE=true

# Replace before production.
JWT_SECRET=replace-with-a-long-random-secret
PASSWORD_PEPPER=replace-with-a-long-random-pepper
DEV_DEFAULT_PASSWORD=Password123!
UPLOAD_DIR=

# Future payment provider configuration.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Compliance reminder automation.
COMPLIANCE_AUTOMATION_ENABLED=true
COMPLIANCE_AUTOMATION_INTERVAL_MINUTES=360

# Basic API rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
